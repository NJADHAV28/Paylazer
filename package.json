{
  "name": "paylazar",
  "version": "1.0.0",
  "private": true,
  "description": "Paylazar: recovers failed payments, abandoned checkouts, failed subscriptions and overdue invoices from a Razorpay account",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix web install",
    "dev": "node scripts/dev.js",
    "server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "npm --prefix web run build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"server/test/*.test.js\"",
    "train": "node scripts/train.js",
    "score": "node scripts/score.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.1.0"
  }
}
